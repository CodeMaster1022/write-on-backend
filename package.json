{
  "name": "write-on-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Write on! API — Express + MongoDB",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seed.ts",
    "normalize-grades": "tsx src/seed/normalize-grades.ts",
    "make-admin": "tsx src/seed/make-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e-server": "tsx tests/e2e-server.ts",
    "backup": "tsx src/seed/backup.ts",
    "restore": "tsx src/seed/restore.ts"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.12.0",
    "@sentry/node": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "docx": "9.7.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.1",
    "morgan": "^1.10.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
