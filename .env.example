NODE_ENV=development
PORT=4000

# Local MongoDB, or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/write-on

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list is allowed
CLIENT_ORIGIN=http://localhost:3000

# Optional — powers "Use AI to analyze for improvements". Get a key at
# https://platform.openai.com/api-keys. Leave unset to disable the feature
# (it returns a friendly "not set up yet" error instead of crashing).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Read-aloud ("Play audio" buttons) — reuses OPENAI_API_KEY above.
# Female voice options: nova, shimmer. Male/neutral: alloy, echo, fable, onyx.
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Optional — powers the "dictate" mic button on answer fields (real-time
# speech-to-text). Get a free key at https://console.deepgram.com.
DEEPGRAM_API_KEY=

# Optional — emailing progress reports to parents and teachers. Get a key at
# https://resend.com. EMAIL_FROM's domain must be verified in Resend; the
# default onboarding@resend.dev only delivers to your own Resend inbox.
EMAIL_API_KEY=
EMAIL_FROM=Write on! <onboarding@resend.dev>

# The website address used in links inside emails (password reset).
# Defaults to the first CLIENT_ORIGIN. Set it to the live site, e.g. https://write-on.app
APP_URL=

# Optional — error alerts through Sentry (https://sentry.io). Leave unset to
# only write errors to the server log. Student writing is never sent.
SENTRY_DSN=

# Daily jobs (new-lesson emails, parent reminders, the admin digest). Vercel Cron calls
# GET /api/jobs/daily with this as a bearer token; any 16+ character secret. Leave empty to
# turn the route off and run `npm run daily-jobs` from a server cron instead.
CRON_SECRET=

# Premium plan, paid by parents through Stripe Checkout (test keys from dashboard.stripe.com → Developers → API keys).
# All four are needed; without them everyone stays on the free plan (plus the 14-day trial). The price IDs are the two
# prices (monthly, yearly) of the one Premium product. The webhook secret comes from the webhook endpoint you add
# at <API>/api/billing/webhook, or from `stripe listen --forward-to localhost:4000/api/billing/webhook` locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Set to true once Stripe Tax is turned on in the dashboard, so Checkout adds sales tax.
STRIPE_AUTOMATIC_TAX=false

# Production only. The API refuses requests that didn't arrive over HTTPS.
# Set to true only while moving a server over to HTTPS, then remove it.
ALLOW_HTTP=false

# Optional — a lasting home for read-aloud audio of the app's own instructions (Cloudinary).
# Without it, audio is only kept on the server's disk, which Vercel wipes on every restart.
# Cloudinary dashboard → Settings → API keys. Format: cloudinary://<api key>:<api secret>@<cloud name>
# Only the app's fixed instructions go there, never a student's writing. Check it with: npm run check-cloudinary
CLOUDINARY_URL=
